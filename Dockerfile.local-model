# Self-contained Linux x86_64 demo. Docker execution itself must be verified before publication.
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
COPY scripts ./scripts
COPY licenses ./licenses
RUN bash scripts/setup-local-model.sh
COPY src ./src
COPY public ./public
RUN mkdir -p /app/data /aikart && chown -R node:node /app /aikart
USER node
ENV HOST=0.0.0.0 PORT=8787 DATA_DIR=/app/data
EXPOSE 8787
CMD ["bash", "scripts/container-run.sh", "web"]
